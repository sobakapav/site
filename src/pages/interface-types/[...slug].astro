---
import { getCollection } from 'astro:content';

import IndustryPage from '~/components/pages/IndustryPage.astro';

export async function getStaticPaths() {
  const industries = await getCollection('interface-types');
  return industries.map(entry => ({
    params: { slug: entry.slug }, props: { entry },
  }));
}

const { entry } = Astro.props;

---

<IndustryPage entry={entry} parent="/interface-types" parentTitle="Типы интерфейсов" />
